  "interactions": [
    {
      "id": "send-message",
      "screen": "cozymate.conversation",
      "trigger": "composer.send",
      "from": "composer.ready",
      "to": "streaming",
      "status": "interactionVerified",
      "behavior": "Archive the exact visible welcome as one ordinary assistant bubble, followed by the user message and the real streaming/reply state; keep bottom navigation."
    },
    {
      "id": "stop-stream",
      "screen": "cozymate.conversation",
      "trigger": "composer.stop",
      "from": "streaming",
      "to": "reply",
      "status": "implemented",
      "behavior": "stop stream and drain visible text"
    },
    {
      "id": "open-attachments",
      "screen": "cozymate.conversation",
      "trigger": "composer.attachment",
      "from": "composer.ready",
      "to": "attachment-menu",
      "status": "implemented",
      "behavior": "show anchored menu"
    },
    {
      "id": "select-image",
      "screen": "cozymate.conversation",
      "trigger": "attachmentMenu.photo",
      "from": "attachment-menu",
      "to": "pending-image",
      "status": "implemented",
      "behavior": "keep draft and show compact preview"
    },
    {
      "id": "select-file",
      "screen": "cozymate.conversation",
      "trigger": "attachmentMenu.file",
      "from": "attachment-menu",
      "to": "pending-file",
      "status": "implemented",
      "behavior": "keep draft and show compact metadata"
    },
    {
      "id": "upload-attachment",
      "screen": "cozymate.conversation",
      "trigger": "attachment.send",
      "from": "pending-image",
      "to": "uploading",
      "status": "implemented",
      "behavior": "disable send while upload is active"
    },
    {
      "id": "attachment-success",
      "screen": "cozymate.conversation",
      "trigger": "upload.completed",
      "from": "uploading",
      "to": "sent-image",
      "status": "implemented",
      "behavior": "render image directly at bounded size"
    },
    {
      "id": "attachment-failure",
      "screen": "cozymate.conversation",
      "trigger": "upload.failed",
      "from": "uploading",
      "to": "image-error",
      "status": "implemented",
      "behavior": "preserve draft and expose retry"
    },
    {
      "id": "connection-recovery",
      "screen": "cozymate.conversation",
      "trigger": "stream.reconnected",
      "from": "disconnected-partial",
      "to": "resumed",
      "status": "implemented",
      "behavior": "resume current run without losing draft"
    }
  ],
