{
  "name": "momcozy-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:legacy-reference": "node scripts/capture-legacy-web-references.mjs",
    "ui:parity-report": "node scripts/compare-ui-parity.mjs",
    "ui:parity-refresh": "npm run ui:legacy-reference && cd flutter_app && PATH=\"$HOME/.local/share/momcozy-toolchains/flutter/bin:$PATH\" flutter test --update-goldens test/features/app_pages/momcozy_feature_golden_test.dart && cd .. && npm run ui:parity-report",
    "ui:parity-gate": "MOMCOZY_UI_PARITY_FAIL=1 node scripts/compare-ui-parity.mjs",
    "flutter:check": "node scripts/check-flutter-toolchain.mjs",
    "flutter:init": "node scripts/init-flutter-shell.mjs",
    "flutter:dev": "cd flutter_app && PATH=\"$HOME/.local/share/momcozy-toolchains/flutter/bin:$PATH\" flutter run --flavor local",
    "flutter:packaging-check": "node scripts/check-flutter-android-packaging.mjs",
    "flutter:security-check": "node scripts/check-flutter-security-privacy.mjs",
    "flutter:p0:platform-smoke": "node scripts/run-flutter-platform-smoke.mjs",
    "flutter:emulator-smoke": "node scripts/run-flutter-emulator-smoke.mjs",
    "flutter:rollback-check": "node scripts/write-flutter-rollback-manifest.mjs",
    "flutter:release-gate": "node scripts/run-flutter-release-gate.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-speech-recognition": "^8.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.35.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "patch-package": "^8.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  },
  "description": "Momcozy mobile app frontend"
}
