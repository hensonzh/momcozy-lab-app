      "type": "text",
      "text": "const imgOriginalCozymatePortrait = \"https://www.figma.com/api/mcp/asset/d537c434-7420-45e0-bc27-95238136b33d.png\";\nconst imgExistingNurseryPhoto = \"https://www.figma.com/api/mcp/asset/615157c5-8e83-4b0b-abb1-2679434f5d99.png\";\nconst imgAvatarCozymateNav = \"https://www.figma.com/api/mcp/asset/dd82c6e5-e5b0-45fd-b9b1-9fe8174c9c48.png\";\nconst imgIconMoon = \"https://www.figma.com/api/mcp/asset/a98fd6de-85d2-4b23-b762-e9b9b92af0d7.svg\";\nconst imgIconDrop = \"https://www.figma.com/api/mcp/asset/72ab5992-5ac7-4fc2-b022-bcf1c47b031e.svg\";\nconst imgIconNote = \"https://www.figma.com/api/mcp/asset/35a2c4dd-2f52-42b9-9531-2912888fe234.svg\";\nconst imgIconDrop1 = \"https://www.figma.com/api/mcp/asset/89693fdd-65cd-4567-b941-0943fbe9e345.svg\";\nconst imgReferenceVisualFlutterRetainsAuthoritativeWhoData = \"https://www.figma.com/api/mcp/asset/c19ea075-30af-43a6-836b-b4856feeb508.svg\";\nconst imgIconMe = \"https://www.figma.com/api/mcp/asset/cc8e0570-d648-4000-9a93-11488e3d4f2c.svg\";\nconst imgIconBaby = \"https://www.figma.com/api/mcp/asset/509a47c4-9a9e-4369-a227-5bf21ab9a11b.svg\";\nconst imgIconSchedule = \"https://www.figma.com/api/mcp/asset/9b8ae06b-0652-4d12-8bf7-ab4dc287c21a.svg\";\nconst imgIconMore = \"https://www.figma.com/api/mcp/asset/0d6b0393-58dd-4349-bfa5-2c58d3220c70.svg\";\n\nexport default function BabyHomeRecorded1X() {\n  return (\n    <div className=\"bg-[#fbf8f4] content-stretch flex flex-col items-start relative size-full\" data-node-id=\"326:1086\" data-name=\"Baby home / recorded / 1x\">\n      <div className=\"bg-[#fbf8f4] content-stretch flex flex-col gap-[14px] items-start overflow-clip p-[16px] relative shrink-0 w-[390px]\" data-node-id=\"326:1087\" data-name=\"Scrollable page\">\n        <div className=\"[word-break:break-word] content-stretch flex gap-[8px] items-center leading-[1.4] overflow-clip relative shrink-0 w-[358px]\" data-node-id=\"326:1088\" data-name=\"Current baby\">\n          <p className=\"font-['Noto_Sans_SC:Bold'] font-bold relative shrink-0 text-[#2b2826] text-[26px] w-[314px]\" data-node-id=\"326:1089\">\n            Luna\n          </p>\n          <p className=\"font-['Noto_Sans_SC:Regular'] font-normal relative shrink-0 text-[#b54f78] text-[24px] w-[36px]\" data-node-id=\"326:1090\">\n            ⌄\n          </p>\n        </div>\n        <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Regular'] font-normal leading-[1.4] relative shrink-0 text-[#776e69] text-[12px] w-[358px]\" data-node-id=\"326:1091\">\n          女宝宝 · 3 周\n        </p>\n        <div className=\"bg-gradient-to-r content-stretch flex flex-col from-[#fff3ee] gap-[12px] items-start overflow-clip p-[18px] relative rounded-[22px] shrink-0 to-[#ead9fb] via-1/2 via-[#f8f0f7] w-[358px]\" data-node-id=\"326:1092\" data-name=\"Knowledge summary\">\n          <div className=\"content-stretch flex gap-[12px] items-start overflow-clip relative shrink-0 w-[322px]\" data-node-id=\"326:1093\" data-name=\"Summary title and original portrait\">\n            <div className=\"[word-break:break-word] content-stretch flex flex-col gap-[8px] items-start leading-[1.4] overflow-clip relative shrink-0 w-[260px]\" data-node-id=\"326:1094\" data-name=\"Summary heading\">\n              <p className=\"font-['Noto_Sans_SC:Regular'] font-normal relative shrink-0 text-[#776e69] text-[12px] w-[260px]\" data-node-id=\"326:1095\">\n                更好地了解 Luna\n              </p>\n              <p className=\"font-['Noto_Sans_SC:Bold'] font-bold relative shrink-0 text-[#2b2826] text-[18px] w-[260px]\" data-node-id=\"326:1096\">\n                比时间表更早出现的，是宝宝的饥饱信号\n              </p>\n            </div>\n            <div className=\"relative rounded-[25px] shrink-0 size-[50px]\" data-node-id=\"326:1097\" data-name=\"Original Cozymate portrait\">\n              <img alt=\"\" className=\"absolute inset-0 max-w-none object-cover pointer-events-none rounded-[25px] size-full\" src={imgOriginalCozymatePortrait} />\n            </div>\n          </div>\n          <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Regular'] font-normal leading-[1.4] relative shrink-0 text-[#776e69] text-[13px] w-[322px]\" data-node-id=\"326:1098\">\n            新生宝宝会用动作表达需要。把记录时间和当时看到的信号放在一起回想，能更从容地认识宝宝自己的节奏。\n          </p>\n          <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Regular'] font-normal leading-[1.4] relative shrink-0 text-[#b54f78] text-[22px] text-right w-[322px]\" data-node-id=\"326:1099\">\n            →\n          </p>\n        </div>\n        <div className=\"content-stretch flex gap-[8px] items-center overflow-clip relative shrink-0 w-[358px]\" data-node-id=\"326:1100\" data-name=\"Section / 今日状态\">\n          <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[#2b2826] text-[18px] w-[282px]\" data-node-id=\"326:1101\">\n            今日状态\n          </p>\n          <div className=\"content-stretch flex flex-col items-start overflow-clip px-[10px] py-[13px] relative rounded-[14px] shrink-0 w-[68px]\" data-node-id=\"326:1102\" data-name=\"Action / 记录\">\n            <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[#b54f78] text-[13px] text-center w-[48px]\" data-node-id=\"326:1103\">\n              记录\n            </p>\n          </div>\n        </div>\n        <div className=\"content-stretch flex gap-[10px] items-start overflow-clip relative shrink-0 w-[358px]\" data-node-id=\"326:1104\" data-name=\"Daily summary\">\n          <div className=\"bg-gradient-to-r content-stretch flex flex-col from-[#f8f2e9] h-[148px] items-start justify-between overflow-clip p-[12px] relative rounded-[22px] shrink-0 to-[#f4eadb] w-[112.667px]\" data-node-id=\"326:1105\" data-name=\"睡眠 summary\">\n            <div className=\"content-stretch flex flex-col gap-[8px] items-start overflow-clip relative shrink-0 w-[88.667px]\" data-node-id=\"326:1106\" data-name=\"Label and icon\">\n              <div className=\"relative shrink-0 size-[28px]\" data-node-id=\"326:1107\" data-name=\"Icon / moon\">\n                <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgIconMoon} />\n              </div>\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Regular'] font-normal leading-[1.4] relative shrink-0 text-[#776e69] text-[14px] w-[88.667px]\" data-node-id=\"326:1109\">\n                睡眠\n              </p>\n            </div>\n            <div className=\"[word-break:break-word] content-stretch flex flex-col gap-[2px] items-start leading-[1.4] overflow-clip relative shrink-0 w-[88.667px]\" data-node-id=\"326:1110\" data-name=\"Value\">\n              <p className=\"font-['Noto_Sans_SC:Regular'] font-normal relative shrink-0 text-[#776e69] text-[12px] w-[88.667px]\" data-node-id=\"326:1111\">\n                累计\n              </p>\n              <p className=\"font-['Noto_Sans_SC:Bold'] font-bold relative shrink-0 text-[#2b2826] text-[20px] w-[88.667px]\" data-node-id=\"326:1112\">\n                2 小时\n              </p>\n            </div>\n          </div>\n          <div className=\"bg-gradient-to-r content-stretch flex flex-col from-[#f7f1e7] h-[148px] items-start justify-between overflow-clip p-[12px] relative rounded-[22px] shrink-0 to-[#f2e9db] w-[112.667px]\" data-node-id=\"326:1113\" data-name=\"尿湿 summary\">\n            <div className=\"content-stretch flex flex-col gap-[8px] items-start overflow-clip relative shrink-0 w-[88.667px]\" data-node-id=\"326:1114\" data-name=\"Label and icon\">\n              <div className=\"relative shrink-0 size-[28px]\" data-node-id=\"326:1115\" data-name=\"Icon / drop\">\n                <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgIconDrop} />\n              </div>\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Regular'] font-normal leading-[1.4] relative shrink-0 text-[#776e69] text-[14px] w-[88.667px]\" data-node-id=\"326:1117\">\n                尿湿\n              </p>\n            </div>\n            <div className=\"content-stretch flex flex-col items-start overflow-clip relative shrink-0 w-[88.667px]\" data-node-id=\"326:1118\" data-name=\"Value\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[#2b2826] text-[20px] w-[88.667px]\" data-node-id=\"326:1119\">\n                1 次\n              </p>\n            </div>\n          </div>\n          <div className=\"bg-gradient-to-r content-stretch flex flex-col from-[#fbece8] h-[148px] items-start justify-between overflow-clip p-[12px] relative rounded-[22px] shrink-0 to-[#f7e3df] w-[112.667px]\" data-node-id=\"326:1120\" data-name=\"便便 summary\">\n            <div className=\"content-stretch flex flex-col gap-[8px] items-start overflow-clip relative shrink-0 w-[88.667px]\" data-node-id=\"326:1121\" data-name=\"Label and icon\">\n              <div className=\"relative shrink-0 size-[28px]\" data-node-id=\"326:1122\" data-name=\"Icon / note\">\n                <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgIconNote} />\n              </div>\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Regular'] font-normal leading-[1.4] relative shrink-0 text-[#776e69] text-[14px] w-[88.667px]\" data-node-id=\"326:1125\">\n                便便\n              </p>\n            </div>\n            <div className=\"content-stretch flex flex-col items-start overflow-clip relative shrink-0 w-[88.667px]\" data-node-id=\"326:1126\" data-name=\"Value\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[#2b2826] text-[20px] w-[88.667px]\" data-node-id=\"326:1127\">\n                1 次\n              </p>\n            </div>\n          </div>\n        </div>\n        <div className=\"content-stretch flex gap-[8px] items-center overflow-clip relative shrink-0 w-[358px]\" data-node-id=\"326:1128\" data-name=\"Section / 今日吃奶\">\n          <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[#2b2826] text-[18px] w-[282px]\" data-node-id=\"326:1129\">\n            今日吃奶\n          </p>\n          <div className=\"content-stretch flex flex-col items-start overflow-clip px-[10px] py-[13px] relative rounded-[14px] shrink-0 w-[68px]\" data-node-id=\"326:1130\" data-name=\"Action / 记录\">\n            <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[#b54f78] text-[13px] text-center w-[48px]\" data-node-id=\"326:1131\">\n              记录\n            </p>\n          </div>\n        </div>\n        <div className=\"bg-gradient-to-r content-stretch flex flex-col from-[#fbece8] gap-[10px] items-start overflow-clip p-[16px] relative rounded-[22px] shrink-0 to-[#f7e5e1] w-[358px]\" data-node-id=\"326:1132\" data-name=\"Feeding summary\">\n          <div className=\"content-stretch flex gap-[12px] items-center overflow-clip relative shrink-0 w-[326px]\" data-node-id=\"326:1133\" data-name=\"Feeding count\">\n            <div className=\"relative shrink-0 size-[28px]\" data-node-id=\"326:1134\" data-name=\"Icon / drop\">\n              <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgIconDrop1} />\n            </div>\n            <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[#2b2826] text-[24px] w-[254px]\" data-node-id=\"326:1136\">\n              1 次\n            </p>\n            <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Regular'] font-normal leading-[1.4] relative shrink-0 text-[#b54f78] text-[22px] w-[28px]\" data-node-id=\"326:1137\">\n              →\n            </p>\n          </div>\n          <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Regular'] font-normal leading-[1.4] relative shrink-0 text-[#776e69] text-[13px] w-[326px]\" data-node-id=\"326:1138\">\n            最近 17:00 · 已记录瓶喂 60 ml\n          </p>\n        </div>\n        <div className=\"content-stretch flex gap-[8px] items-center overflow-clip relative shrink-0 w-[358px]\" data-node-id=\"326:1139\" data-name=\"Section / 生长发育记录\">\n          <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[#2b2826] text-[18px] w-[282px]\" data-node-id=\"326:1140\">\n            生长发育记录\n          </p>\n          <div className=\"content-stretch flex flex-col items-start overflow-clip px-[10px] py-[13px] relative rounded-[14px] shrink-0 w-[68px]\" data-node-id=\"326:1141\" data-name=\"Action / 记录\">\n            <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[#b54f78] text-[13px] text-center w-[48px]\" data-node-id=\"326:1142\">\n              记录\n            </p>\n          </div>\n        </div>\n        <div className=\"[word-break:break-word] content-stretch flex gap-[10px] items-center leading-[1.4] overflow-clip relative shrink-0 w-[358px]\" data-node-id=\"326:1143\" data-name=\"Latest measurements\">\n          <div className=\"bg-[#fffdfc] border border-[#e9e1dc] border-solid content-stretch flex flex-col gap-[8px] items-start overflow-clip p-[12px] relative rounded-[22px] shrink-0 w-[112.667px]\" data-node-id=\"326:1144\" data-name=\"体重\">\n            <p className=\"font-['Noto_Sans_SC:Regular'] font-normal relative shrink-0 text-[#776e69] text-[13px] w-[88.667px]\" data-node-id=\"326:1145\">\n              体重\n            </p>\n            <p className=\"font-['Noto_Sans_SC:Bold'] font-bold relative shrink-0 text-[#2b2826] text-[24px] w-[88.667px]\" data-node-id=\"326:1146\">\n              4.2 kg\n            </p>\n            <p className=\"font-['Noto_Sans_SC:Regular'] font-normal relative shrink-0 text-[#776e69] text-[12px] w-[88.667px]\" data-node-id=\"326:1147\">\n              9/8\n            </p>\n          </div>\n          <div className=\"bg-[#fffdfc] border border-[#e9e1dc] border-solid content-stretch flex flex-col gap-[8px] items-start overflow-clip p-[12px] relative rounded-[22px] shrink-0 w-[112.667px]\" data-node-id=\"326:1148\" data-name=\"身长\">\n            <p className=\"font-['Noto_Sans_SC:Regular'] font-normal relative shrink-0 text-[#776e69] text-[13px] w-[88.667px]\" data-node-id=\"326:1149\">\n              身长\n            </p>\n            <p className=\"font-['Noto_Sans_SC:Bold'] font-bold relative shrink-0 text-[#2b2826] text-[24px] w-[88.667px]\" data-node-id=\"326:1150\">\n              54 cm\n            </p>\n            <p className=\"font-['Noto_Sans_SC:Regular'] font-normal relative shrink-0 text-[#776e69] text-[12px] w-[88.667px]\" data-node-id=\"326:1151\">\n              9/8\n            </p>\n          </div>\n          <div className=\"bg-[#fffdfc] border border-[#e9e1dc] border-solid content-stretch flex flex-col gap-[8px] items-start overflow-clip p-[12px] relative rounded-[22px] shrink-0 w-[112.667px]\" data-node-id=\"326:1152\" data-name=\"头围\">\n            <p className=\"font-['Noto_Sans_SC:Regular'] font-normal relative shrink-0 text-[#776e69] text-[13px] w-[88.667px]\" data-node-id=\"326:1153\">\n              头围\n            </p>\n            <p className=\"font-['Noto_Sans_SC:Bold'] font-bold relative shrink-0 text-[#2b2826] text-[24px] w-[88.667px]\" data-node-id=\"326:1154\">\n              36 cm\n            </p>\n            <p className=\"font-['Noto_Sans_SC:Regular'] font-normal relative shrink-0 text-[#776e69] text-[12px] w-[88.667px]\" data-node-id=\"326:1155\">\n              9/8\n            </p>\n          </div>\n        </div>\n        <div className=\"bg-[#fffdfc] border border-[#e9e1dc] border-solid content-stretch flex flex-col gap-[12px] items-start overflow-clip p-[16px] relative rounded-[22px] shrink-0 w-[358px]\" data-node-id=\"326:1156\" data-name=\"Growth trend / 体重\">\n          <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[#2b2826] text-[16px] w-[326px]\" data-node-id=\"326:1157\">\n            生长趋势\n          </p>\n          <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Regular'] font-normal leading-[1.4] relative shrink-0 text-[#776e69] text-[12px] w-[326px]\" data-node-id=\"326:1158\">\n            出生至 6 月 · 女宝宝 · kg\n          </p>\n          <div className=\"bg-[#f2ebe5] content-stretch flex gap-[4px] items-center overflow-clip relative rounded-[14px] shrink-0 w-[326px]\" data-node-id=\"326:1159\" data-name=\"Growth metric selection\">\n            <div className=\"bg-[#e8f3ef] content-stretch flex flex-col items-start overflow-clip px-[10px] py-[13px] relative rounded-[14px] shrink-0 w-[106px]\" data-node-id=\"326:1160\" data-name=\"Action / 体重\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[#3e7180] text-[13px] text-center w-[86px]\" data-node-id=\"326:1161\">\n                体重\n              </p>\n            </div>\n            <div className=\"content-stretch flex flex-col items-start overflow-clip px-[10px] py-[13px] relative rounded-[14px] shrink-0 w-[106px]\" data-node-id=\"326:1162\" data-name=\"Action / 身长\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[#b54f78] text-[13px] text-center w-[86px]\" data-node-id=\"326:1163\">\n                身长\n              </p>\n            </div>\n            <div className=\"content-stretch flex flex-col items-start overflow-clip px-[10px] py-[13px] relative rounded-[14px] shrink-0 w-[106px]\" data-node-id=\"326:1164\" data-name=\"Action / 头围\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] fon