col items-start p-[16px] relative rounded-[22px] shrink-0 w-full\" data-node-id=\"173:1139\" data-name=\"基础信息\">\n          <div className=\"[word-break:break-word] content-stretch flex gap-[8px] items-center leading-[1.4] relative shrink-0 w-full\" data-node-id=\"173:1140\" data-name=\"disclosure-header\">\n            <p className=\"flex-[1_0_0] font-['Noto_Sans_SC:Bold'] font-bold min-w-px relative text-[15px] text-[color:var(--momcozy\\/ink,#2b2826)]\" data-node-id=\"173:1141\">\n              基础信息\n            </p>\n            <p className=\"font-['Noto_Sans_SC:Regular'] font-normal relative shrink-0 text-[12px] text-[color:var(--momcozy\\/secondary,#776e69)] w-[137.25px] whitespace-pre-wrap\" data-node-id=\"173:1142\">{`已预填，可修改  ⌄`}</p>\n          </div>\n        </div>\n        <div className=\"bg-[var(--momcozy\\/surface,#fffdfc)] border border-[var(--momcozy\\/border,#e9e1dc)] border-solid content-stretch flex flex-col gap-[14px] items-start p-[16px] relative rounded-[22px] shrink-0 w-full\" data-node-id=\"173:1143\" data-name=\"explicit-consent\">\n          <div className=\"content-stretch flex flex-col gap-[8px] items-start relative shrink-0 w-full\" data-node-id=\"173:1144\" data-name=\"consent-heading\">\n            <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[16px] text-[color:var(--momcozy\\/ink,#2b2826)] w-full\" data-node-id=\"173:1145\">\n              信息使用\n            </p>\n            <div className=\"content-stretch flex flex-col items-start justify-center min-h-[44px] p-[12px] relative rounded-[16px] shrink-0 w-full\" data-node-id=\"173:1146\" data-name=\"button/查看说明\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[13px] text-[color:var(--momcozy\\/rose,#b54f78)] text-center w-full\" data-node-id=\"173:1147\">\n                查看说明\n              </p>\n            </div>\n          </div>\n          <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Regular'] font-normal leading-[1.55] relative shrink-0 text-[13px] text-[color:var(--momcozy\\/ink,#2b2826)] w-full\" data-node-id=\"173:1148\">\n            □ 允许本次服务的 IBCLC 查看此表\n          </p>\n        </div>\n        <div className=\"bg-[var(--momcozy\\/rose,#b54f78)] content-stretch flex flex-col items-start justify-center min-h-[44px] opacity-40 p-[12px] relative rounded-[16px] shrink-0 w-full\" data-node-id=\"173:1149\" data-name=\"button/保存信息\">\n          <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[13px] text-[color:var(--momcozy\\/surface,#fffdfc)] text-center w-full\" data-node-id=\"173:1150\">\n            保存信息\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n}"
