      "text": "export default function IntakeForm() {\n  return (\n    <div className=\"bg-[var(--momcozy\\/background,#fbf8f4)] content-stretch flex flex-col items-start relative size-full\" data-node-id=\"173:1108\" data-name=\"Intake / form\">\n      <div className=\"content-stretch flex gap-[8px] items-center min-h-[56px] px-[16px] relative shrink-0 w-full\" data-node-id=\"173:1109\" data-name=\"app-bar\">\n        <div className=\"content-stretch flex flex-col items-start justify-center min-h-[44px] p-[12px] relative rounded-[16px] shrink-0 w-[64px]\" data-node-id=\"173:1110\" data-name=\"button/返回\">\n          <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[13px] text-[color:var(--momcozy\\/rose,#b54f78)] text-center w-full\" data-node-id=\"173:1111\">\n            返回\n          </p>\n        </div>\n        <p className=\"[word-break:break-word] flex-[1_0_0] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] min-w-px relative text-[22px] text-[color:var(--momcozy\\/ink,#2b2826)]\" data-node-id=\"173:1112\">\n          信息采集表\n        </p>\n      </div>\n      <div className=\"content-stretch flex flex-col gap-[14px] items-start p-[16px] relative shrink-0 w-full\" data-node-id=\"173:1113\" data-name=\"scroll-content\">\n        <div className=\"bg-[#fbece8] border border-[var(--momcozy\\/border,#e9e1dc)] border-solid content-stretch flex flex-col gap-[14px] items-start p-[16px] relative rounded-[22px] shrink-0 w-full\" data-node-id=\"173:1114\" data-name=\"consultation-focus\">\n          <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[22px] text-[color:var(--momcozy\\/ink,#2b2826)] w-full\" data-node-id=\"173:1115\">\n            这次最想解决什么？\n          </p>\n          <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Regular'] font-normal leading-[1.55] relative shrink-0 text-[12px] text-[color:var(--momcozy\\/secondary,#776e69)] w-full\" data-node-id=\"173:1116\">\n            可多选\n          </p>\n          <div className=\"content-stretch flex gap-[8px] items-center relative shrink-0 w-full\" data-node-id=\"173:1117\" data-name=\"topic-row\">\n            <div className=\"bg-[var(--momcozy\\/mint,#e8f3ef)] border border-[var(--momcozy\\/rose,#b54f78)] border-solid content-stretch flex flex-col items-start justify-center min-h-[44px] p-[12px] relative rounded-[16px] shrink-0 w-[160.5px]\" data-node-id=\"173:1118\" data-name=\"button/含乳困难  ✓\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[13px] text-[color:var(--momcozy\\/rose,#b54f78)] w-full whitespace-pre-wrap\" data-node-id=\"173:1119\">{`含乳困难  ✓`}</p>\n            </div>\n            <div className=\"bg-[var(--momcozy\\/surface,#fffdfc)] border border-[var(--momcozy\\/border,#e9e1dc)] border-solid content-stretch flex flex-col items-start justify-center min-h-[44px] p-[12px] relative rounded-[16px] shrink-0 w-[160.5px]\" data-node-id=\"173:1120\" data-name=\"button/喂养疼痛\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[13px] text-[color:var(--momcozy\\/ink,#2b2826)] w-full\" data-node-id=\"173:1121\">\n                喂养疼痛\n              </p>\n            </div>\n          </div>\n          <div className=\"content-stretch flex gap-[8px] items-center relative shrink-0 w-full\" data-node-id=\"173:1122\" data-name=\"topic-row\">\n            <div className=\"bg-[var(--momcozy\\/surface,#fffdfc)] border border-[var(--momcozy\\/border,#e9e1dc)] border-solid content-stretch flex flex-col items-start justify-center min-h-[44px] p-[12px] relative rounded-[16px] shrink-0 w-[160.5px]\" data-node-id=\"173:1123\" data-name=\"button/奶量担心\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[13px] text-[color:var(--momcozy\\/ink,#2b2826)] w-full\" data-node-id=\"173:1124\">\n                奶量担心\n              </p>\n            </div>\n            <div className=\"bg-[var(--momcozy\\/surface,#fffdfc)] border border-[var(--momcozy\\/border,#e9e1dc)] border-solid content-stretch flex flex-col items-start justify-center min-h-[44px] p-[12px] relative rounded-[16px] shrink-0 w-[160.5px]\" data-node-id=\"173:1125\" data-name=\"button/宝宝频繁醒来\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[13px] text-[color:var(--momcozy\\/ink,#2b2826)] w-full\" data-node-id=\"173:1126\">\n                宝宝频繁醒来\n              </p>\n            </div>\n          </div>\n          <div className=\"content-stretch flex gap-[8px] items-center relative shrink-0 w-full\" data-node-id=\"173:1127\" data-name=\"topic-row\">\n            <div className=\"bg-[var(--momcozy\\/surface,#fffdfc)] border border-[var(--momcozy\\/border,#e9e1dc)] border-solid content-stretch flex flex-col items-start justify-center min-h-[44px] p-[12px] relative rounded-[16px] shrink-0 w-[160.5px]\" data-node-id=\"173:1128\" data-name=\"button/泵奶安排\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[13px] text-[color:var(--momcozy\\/ink,#2b2826)] w-full\" data-node-id=\"173:1129\">\n                泵奶安排\n              </p>\n            </div>\n            <div className=\"bg-[var(--momcozy\\/surface,#fffdfc)] border border-[var(--momcozy\\/border,#e9e1dc)] border-solid content-stretch flex flex-col items-start justify-center min-h-[44px] p-[12px] relative rounded-[16px] shrink-0 w-[160.5px]\" data-node-id=\"173:1130\" data-name=\"button/其他\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[13px] text-[color:var(--momcozy\\/ink,#2b2826)] w-full\" data-node-id=\"173:1131\">\n      