      "text": "export default function PreparationReady() {\n  return (\n    <div className=\"bg-[var(--momcozy\\/background,#fbf8f4)] content-stretch flex flex-col items-start relative size-full\" data-node-id=\"178:1108\" data-name=\"Preparation / ready\">\n      <div className=\"absolute content-stretch flex flex-col h-[844px] items-start justify-end left-0 p-[18px] top-0 w-[393px]\" data-node-id=\"178:1109\" data-name=\"preparation-overlay\">\n        <div className=\"bg-[var(--momcozy\\/surface,#fffdfc)] content-stretch flex flex-col gap-[16px] items-start overflow-clip p-[24px] relative rounded-[24px] shrink-0 w-full\" data-node-id=\"178:1110\" data-name=\"MomSettingsFlowDialog\">\n          <div className=\"content-stretch flex gap-[8px] items-center relative shrink-0 w-full\" data-node-id=\"178:1111\" data-name=\"dialog-header\">\n            <p className=\"[word-break:break-word] flex-[1_0_0] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] min-w-px relative text-[20px] text-[color:var(--momcozy\\/ink,#2b2826)]\" data-node-id=\"178:1112\">\n              预约详情\n            </p>\n            <div className=\"content-stretch flex flex-col items-start justify-center min-h-[44px] p-[12px] relative rounded-[16px] shrink-0 w-[44px]\" data-node-id=\"178:1113\" data-name=\"button/×\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[13px] text-[color:var(--momcozy\\/rose,#b54f78)] text-center w-full\" data-node-id=\"178:1114\">\n                ×\n              </p>\n            </div>\n          </div>\n          <div className=\"content-stretch flex flex-col gap-[14px] items-start overflow-clip relative shrink-0 w-full\" data-node-id=\"178:1115\" data-name=\"scrollable-content\">\n            <div className=\"bg-[var(--momcozy\\/mint,#e8f3ef)] border border-[var(--momcozy\\/border,#e9e1dc)] border-solid content-stretch flex flex-col gap-[14px] items-start p-[16px] relative rounded-[2