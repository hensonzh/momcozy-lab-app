p className=\"[word-break:break-word] font-['Noto_Sans_SC:Regular'] font-normal leading-[1.4] relative shrink-0 text-[#2b2826] text-[16px] w-[246px]\" data-node-id=\"317:1138\">\n                    2026-08-22\n                  </p>\n                  <div className=\"absolute border-[#776e69] border-[1.5px] border-solid h-[16px] left-[271px] overflow-clip rounded-[2px] top-[15px] w-[18px]\" data-node-id=\"318:1089\" data-name=\"Calendar outline\">\n                    <div className=\"absolute bg-[#776e69] h-px left-[-1.5px] top-[2.5px] w-[16px]\" data-node-id=\"318:1090\" data-name=\"Rectangle\" />\n                  </div>\n                </div>\n              </div>\n              <div className=\"bg-[#fffdfc] content-stretch flex flex-col items-center overflow-clip px-[10px] py-[12px] relative rounded-[16px] shrink-0 w-[302px]\" data-node-id=\"317:1139\" data-name=\"Button / 清除日期\">\n                <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[#b54f78] text-[13px] text-center w-[282px]\" data-node-id=\"317:1140\">\n                  清除日期\n                </p>\n              </div>\n            </div>\n            <div className=\"bg-[#fffdfc] border border-[#e9e1dc] border-solid content-stretch flex flex-col gap-[14px] items-start overflow-clip p-[16px] relative rounded-[22px] shrink-0 w-[334px]\" data-node-id=\"317:1141\" data-name=\"Growth reference and feeding\">\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[1.4] relative shrink-0 text-[#2b2826] text-[14px] w-[302px]\" data-node-id=\"317:1142\">\n                出生记录性别\n              </p>\n              <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Regular'] font-normal leading-[1.4] relative shrink-0 text-[#776e69] text-[12px] w-[302px]\" data-node-id=\"317:1143\">\n                用于匹配生长参考范围\n              </p>\n              <div className=\"bg-[#fffdfc] content-stretch