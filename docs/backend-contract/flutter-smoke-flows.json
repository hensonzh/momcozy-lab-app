{
  "version": "0.1.0",
  "base_path": "/v1",
  "rules": {
    "auth_header": "Authorization: Bearer ${access_token}",
    "service_header": "X-Service-Key: ${service_api_key}",
    "idempotency_header": "Idempotency-Key: ${unique_idempotency_key}",
    "no_tokens_in_urls": true
  },
  "flows": [
    {
      "name": "auth_session",
      "service": "product",
      "steps": [
        {
          "method": "POST",
          "path": "/v1/auth/invite-login",
          "body": {
            "invite_code": "${invite_code}",
            "device_id": "flutter-smoke-invite-device"
          },
          "captures": {
            "access_token": "$.access_token",
            "refresh_token": "$.refresh_token"
          }
        },
        {
          "method": "POST",
          "path": "/v1/auth/refresh",
          "body": {
            "refresh_token": "${refresh_token}"
          },
          "captures": {
            "access_token": "$.access_token",
            "refresh_token": "$.refresh_token"
          }
        },
        {
          "method": "POST",
          "path": "/v1/auth/logout",
          "headers": [
            "${auth_header}"
          ]
        }
      ]
    },
    {
      "name": "email_registration_and_password_lifecycle",
      "service": "product",
      "notes": "Run only with an isolated mailbox/account; obtain codes from the email test fixture, not a production inbox. Password changes revoke prior sessions.",
      "steps": [
        {
          "method": "POST",
          "path": "/v1/auth/register",
          "body": {
            "email": "smoke+${run_id}@example.test"
          },
          "assertions": [
            "202; password is not set until verified"
          ]
        },
        {
          "method": "POST",
          "path": "/v1/auth/verify-registration-code",
          "body": {
            "email": "smoke+${run_id}@example.test",
            "token": "${verification_code}"
          },
          "assertions": [
            "validates code without consuming it"
          ]
        },
        {
          "method": "POST",
          "path": "/v1/auth/verify-email",
          "body": {
            "email": "smoke+${run_id}@example.test",
            "token": "${verification_code}",
            "password": "${strong_password}",
            "confirm_password": "${strong_password}"
          },
          "captures": {
            "access_token": "$.access_token",
            "refresh_token": "$.refresh_token"
          }
        },
        {
          "method": "GET",
          "path": "/v1/auth/me",
          "headers": [
            "${auth_header}"
          ]
        },
        {
          "method": "POST",
          "path": "/v1/auth/forgot-password",
          "body": {
            "email": "smoke+${run_id}@example.test"
          }
        },
        {
          "method": "POST",
          "path": "/v1/auth/reset-password",
          "body": {
            "email": "smoke+${run_id}@example.test",
            "token": "${reset_code}",
            "new_password": "${new_password}",
            "confirm_password": "${new_password}"
          }
        },
        {
          "method": "POST",
          "path": "/v1/auth/login",
          "body": {
            "email": "smoke+${run_id}@example.test",
            "password": "${new_password}"
          },
          "captures": {
            "access_token": "$.access_token",
            "refresh_token": "$.refresh_token"
          }
        },
        {
          "method": "POST",
          "path": "/v1/auth/change-password",
          "headers": [
            "${auth_header}"
          ],
          "body": {
            "current_password": "${new_password}",
            "new_password": "${changed_password}",
            "confirm_password": "${changed_password}"
          }
        }
      ]
    },
    {
      "name": "fresh_user_onboarding",
      "service": "product",
      "notes": "Use a new verified user without an existing current-delivery infant; repeat PUT must be idempotent.",
      "steps": [
        {
          "method": "GET",
          "path": "/v1/onboarding/me",
          "headers": [
            "${auth_header}"
          ],
          "assertions": [
            "status required; profile_confirmed false"
          ]
        },
        {
          "method": "PUT",
          "path": "/v1/onboarding/me/profile",
          "headers": [
            "${auth_header}"
          ],
          "body": {
            "stage": "postpartum",
            "display_name": "Smoke User",
            "age": 32,
            "delivery_date": "${today}",
            "client_timezone_offset_minutes": 0,
            "delivery_count": 1,
            "has_cesarean_history": false,
            "delivery_type": "vaginal",
            "gestation_weeks": 39,
            "gestation_days": 2,
            "feeding_methods": [
              "direct"
            ],
            "infant_count": 1,
            "infants": [
              {
                "nickname": "Smoke Baby",
                "sex": "female"
              }
            ]
          },
          "captures": {
            "baby_id": "$.primary_infant_id"
          }
        },
        {
          "method": "GET",
          "path": "/v1/onboarding/me",
          "headers": [
            "${auth_header}"
          ],
          "assertions": [
            "status completed; profile_confirmed true; primary_infant_id matches"
          ]
        },
        {
          "method": "GET",
          "path": "/v1/babies",
          "headers": [
            "${auth_header}"
          ],
          "assertions": [
            "contains exactly one current-delivery infant for this test account"
          ]
        }
      ]
    },
    {
      "name": "core_records_schedule_files",
      "service": "product",
      "steps": [
        {
          "method": "POST",
          "path": "/v1/files/upload",
          "headers": [
            "${auth_header}",
            "${idempotency_header}"
          ],
          "multipart": {
            "file": {
              "filename": "smoke.txt",
              "content_type": "text/plain",
              "body": "hello smoke"
            }
          }
        },
        {
          "method": "POST",
          "path": "/v1/records/feeding",
          "headers": [
            "${auth_header}",
            "${idempotency_header}"
          ],
          "body": {
            "feed_time": "${iso_now}",
            "feed_type": "bottle",
            "feed_action": "fed",
            "volume_ml": 60,
            "title": "Smoke feeding"
          }
        },
        {
          "method": "GET",
          "path": "/v1/schedule?start_date=${today}&end_date=${tomorrow}&timezone=UTC",
          "headers": [
            "${auth_header}"
          ]
        },
        {
          "method": "GET",
          "path": "/v1/records/feeding",
          "headers": [
            "${auth_header}"
          ]
        }
      ]
    },
    {
      "name": "agent_replay",
      "service": "agent_runtime",
      "steps": [
        {
          "method": "POST",
          "path": "/v1/agent/threads",
          "headers": [
            "${auth_header}"
          ],
          "body": {
            "title": "Smoke agent thread"
          },
          "captures": {
            "thread_id": "$.id"
          }
        },
        {
          "method": "POST",
          "path": "/v1/agent/runs",
          "headers": [
            "${auth_header}",
            "${idempotency_header}"
          ],
          "body": {
            "thread_id": "${thread_id}",
            "message": "Create a smoke-test run without external side effects.",
            "client_context": {
              "source": "flutter-smoke",
              "locale": "en-US",
              "timezone": "Etc/UTC",
              "message_sent_at": "${iso_now}"
            }
          },
          "captures": {
            "run_id": "$.id"
          }
        },
        {
          "method": "GET",
          "path": "/v1/agent/threads/${thread_id}/history?limit=20",
          "headers": [
            "${auth_header}"
          ],
          "assertions": [
            "returns only the authenticated owner conversation",
            "items are chronological and next_before_sequence pages backward"
          ]
        },
        {
          "method": "GET",
          "path": "/v1/agent/runs/${run_id}/events",
          "headers": [
            "${auth_header}"
          ]
        },
        {
          "method": "GET",
          "path": "/v1/agent/runs/${run_id}/stream?after_sequence=0&limit=200",
          "headers": [
            "${auth_header}"
          ],
          "assertions": [
            "no token query parameter"
          ]
        },
        {
          "method": "GET",
          "path": "/v1/agent/runs/${run_id}/stream?after_sequence=0&limit=200&follow=true&poll_interval_seconds=0.5&max_wait_seconds=1",
          "headers": [
            "${auth_header}"
          ],
          "assertions": [
            "no token query parameter",
            "returns persisted application events only"
          ]
        }
      ]
    },
    {
      "name": "voice_contract",
      "service": "product",
      "steps": [
        {
          "method": "POST",
          "path": "/v1/speech/transcribe-chunk",
          "headers": [
            "${auth_header}"
          ],
          "multipart": {
            "file": {
              "filename": "speech.wav",
              "content_type": "audio/wav",
              "body": "voice smoke"
            }
          },
          "assertions": [
            "returns text field or stable voice_provider_disabled error"
          ]
        },
        {
          "method": "GET",
          "path": "/v1/realtime-voice-stream?text=hello",
          "headers": [
            "${auth_header}"
          ],
          "assertions": [
            "no token query parameter",
            "returns audio/pcm or stable voice_provider_disabled error"
          ]
        }
      ]
    }
  ]
}
