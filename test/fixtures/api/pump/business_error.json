{
  "domain": "pump",
  "endpoint": "/v1/pump/workstate",
  "method": "POST",
  "request": {
    "user_id": "demo-user-fixture",
    "device_left": {
      "state": 1,
      "mode": "deep",
      "level": 6
    },
    "device_right": {
      "state": 0,
      "mode": "stimulate",
      "level": 3
    }
  },
  "variant": "business_error",
  "response": {
    "status": 40001,
    "message": "pump fixture business error",
    "data": {
      "error": -1,
      "code": "PUMP_BUSINESS_ERROR",
      "retryable": false
    }
  }
}
