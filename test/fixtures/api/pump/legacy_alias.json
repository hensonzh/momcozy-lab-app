{
  "domain": "pump",
  "endpoint": "/v1/pump/workstate",
  "method": "POST",
  "request": {
    "user_id": "demo-user-fixture",
    "device_left": {
      "state": 1,
      "mode": "deep",
      "level": 6
    },
    "device_right": {
      "state": 0,
      "mode": "stimulate",
      "level": 3
    }
  },
  "variant": "legacy_alias",
  "response": {
    "status": 200,
    "message": "legacy_alias",
    "data": {
      "error": 0,
      "needReply": true,
      "output": "Pump state received.",
      "replyCode": "pump_state_changed",
      "replySide": "left"
    }
  }
}
