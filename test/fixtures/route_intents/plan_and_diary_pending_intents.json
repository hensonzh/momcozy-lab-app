{
  "id": "route-plan-and-diary-pending-intents",
  "description": "Plan and pregnancy diary pending storage keys become typed notification badge and navigation intents.",
  "input": {
    "localStorage": {
      "mmc_birth_journey_plan_nav_pending": "{\"kind\":\"birth_journey_plan\",\"target\":\"status\",\"reason\":\"updated\",\"label\":\"待产计划已更新\",\"planId\":12,\"planType\":\"birth_journey\",\"dates\":[\"2026-06-29\",\"2026-06-30\"],\"summary\":\"新增待办\"}",
      "mmc_birth_journey_plan_card_pending": null,
      "mmc_milk_plan_nav_pending": "{\"kind\":\"milk_plan\",\"target\":\"schedule\",\"reason\":\"rescheduled\",\"label\":\"追奶计划已调整\",\"planType\":\"chase\",\"dates\":[\"2026-06-29\"]}",
      "mmc_milk_plan_schedule_pending": null,
      "mmc_pregnancy_diary_nav_pending": "1",
      "mmc_pregnancy_diary_card_pending": null,
      "mmc_pregnancy_diary_card_label": "legacy-label"
    }
  },
  "expectedIntents": [
    {
      "type": "OpenStatusBirthJourneyBadge",
      "path": "/status",
      "payload": {
        "kind": "birth_journey_plan",
        "reason": "updated",
        "label": "待产计划已更新",
        "planId": 12,
        "planType": "birth_journey",
        "dates": [
          "2026-06-29",
          "2026-06-30"
        ],
        "summary": "新增待办"
      },
      "consume": "once"
    },
    {
      "type": "OpenSchedulePlanBadge",
      "path": "/schedule",
      "payload": {
        "kind": "milk_plan",
        "reason": "rescheduled",
        "label": "追奶计划已调整",
        "planType": "chase",
        "dates": [
          "2026-06-29"
        ]
      },
      "consume": "once"
    },
    {
      "type": "OpenStatusPregnancyDiaryBadge",
      "path": "/status",
      "payload": {
        "source": "pregnancyDiaryChanged"
      },
      "consume": "once"
    }
  ],
  "sideEffects": {
    "transfer": [
      "nav pending key moves to page pending key when destination opens"
    ],
    "deleteLegacyKeys": [
      "mmc_pregnancy_diary_card_label"
    ]
  },
  "assertions": [
    "payload value \"1\" means boolean badge without structured metadata",
    "structured plan payload preserves dates, label, reason, planId, and planType",
    "legacy pregnancy diary card label is discarded",
    "page badge state is separate from navigation intent",
    "duplicate plan dates must be deduped by mapper"
  ]
}
