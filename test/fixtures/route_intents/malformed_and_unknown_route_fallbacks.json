{
  "id": "route-malformed-and-unknown-route-fallbacks",
  "description": "Malformed notification payloads, unsafe routes, and unknown links fall back without crashing.",
  "input": {
    "cases": [
      {
        "source": "native-notification",
        "path": "javascript:alert(1)",
        "notifyJson": "{bad-json"
      },
      {
        "source": "native-notification",
        "path": "/unknown-old-page",
        "notifyJson": "{\"event\":\"summary\",\"body\":\"\"}"
      },
      {
        "source": "media-viewer",
        "state": {
          "kind": "image",
          "url": ""
        }
      },
      {
        "source": "media-viewer",
        "state": {
          "kind": "pdf",
          "url": "/skill-assets/guides/pump.pdf"
        }
      },
      {
        "source": "agent-artifact",
        "route": "/deprecated-prototype"
      }
    ]
  },
  "expectedIntents": [
    {
      "type": "RejectUnsafeRoute",
      "payload": {
        "reason": "unsupported-scheme"
      }
    },
    {
      "type": "NotFoundIntent",
      "path": "/unknown-old-page",
      "payload": {
        "fallback": "AgentHub"
      }
    },
    {
      "type": "MediaViewerMissingResource",
      "path": "/media-viewer",
      "payload": {
        "message": "Resource details are missing. Please open it from the resource card."
      }
    },
    {
      "type": "ShowToast",
      "payload": {
        "message": "This resource has expired. Please request the latest version."
      }
    },
    {
      "type": "AgentArtifactRouteIntent",
      "payload": {
        "rawRoute": "/deprecated-prototype",
        "status": "unknown"
      }
    }
  ],
  "assertions": [
    "malformed notifyJson is ignored and logged as sanitized diagnostic",
    "unsafe route schemes never reach Navigator",
    "unknown same-origin route falls back without crashing",
    "empty media viewer state renders missing-resource UI",
    "retired skill-assets never reach the media viewer",
    "cross-origin IBCLC return_to is rejected"
  ]
}
