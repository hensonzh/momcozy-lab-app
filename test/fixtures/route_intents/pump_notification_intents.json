{
  "id": "route-pump-notification-intents",
  "description": "Lactation foreground and auto-end notifications become typed route intents.",
  "input": {
    "pendingNavigatePayloads": [
      {
        "path": "/pump",
        "autoEndTeardown": false,
        "notifyJson": null
      },
      {
        "path": "/",
        "autoEndTeardown": true,
        "notifyJson": null
      }
    ]
  },
  "expectedIntents": [
    {
      "type": "OpenLactation",
      "path": "/me/lactation",
      "payload": {
        "source": "pumpForegroundNotification"
      },
      "consume": "once"
    },
    {
      "type": "OpenAgentHubAndRunPumpTeardown",
      "path": "/",
      "payload": {
        "source": "pumpAutoEndNotification",
        "dedupe": "tryRunPumpAutoEndOffPumpTeardownOnce"
      },
      "consume": "once"
    }
  ],
  "assertions": [
    "pump notification route is consumed once",
    "auto-end teardown only runs for path / with autoEndTeardown true"
  ]
}
