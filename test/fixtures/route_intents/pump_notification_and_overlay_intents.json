{
  "id": "route-pump-notification-and-overlay-intents",
  "description": "Pump foreground notification, auto-end notification, and overlay route sync become typed route/overlay intents.",
  "input": {
    "pendingNavigatePayloads": [
      {
        "path": "/pump",
        "autoEndTeardown": false,
        "notifyJson": null
      },
      {
        "path": "/",
        "autoEndTeardown": true,
        "notifyJson": null
      }
    ],
    "overlaySnapshots": [
      {
        "platform": "android",
        "permissionGranted": true,
        "state": "running",
        "processAll": 64,
        "routePath": "/pump",
        "appVisible": true
      },
      {
        "platform": "android",
        "permissionGranted": true,
        "state": "running",
        "processAll": 64,
        "routePath": "/schedule",
        "appVisible": false
      },
      {
        "platform": "android",
        "permissionGranted": false,
        "state": "paused",
        "processAll": 72,
        "routePath": "/records",
        "appVisible": false
      }
    ]
  },
  "expectedIntents": [
    {
      "type": "OpenPumpSession",
      "path": "/pump",
      "payload": {
        "source": "pumpForegroundNotification"
      },
      "consume": "once"
    },
    {
      "type": "OpenAgentHubAndRunPumpTeardown",
      "path": "/",
      "payload": {
        "source": "pumpAutoEndNotification",
        "dedupe": "tryRunPumpAutoEndOffPumpTeardownOnce"
      },
      "consume": "once"
    }
  ],
  "expectedOverlayActions": [
    {
      "type": "hide",
      "reason": "route-is-pump-and-app-visible"
    },
    {
      "type": "update",
      "state": "running",
      "processAll": 64,
      "reason": "app-not-visible-or-outside-pump"
    },
    {
      "type": "skip",
      "reason": "overlay-permission-denied"
    }
  ],
  "assertions": [
    "pump notification route is consumed once",
    "auto-end teardown only runs for path / with autoEndTeardown true",
    "overlay hides on /pump while app is visible",
    "overlay updates outside /pump or when app is hidden",
    "overlay permission denial never blocks pump foreground service"
  ]
}
