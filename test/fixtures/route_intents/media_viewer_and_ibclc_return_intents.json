{
  "id": "route-media-viewer-and-ibclc-return-intents",
  "description": "Media viewer and IBCLC service handoff map to typed route intents with safe URL handling.",
  "input": {
    "mediaLinks": [
      {
        "title": "Pumping guide PDF",
        "kind": "pdf",
        "url": "/skill-assets/guides/pump.pdf"
      },
      {
        "title": "How to wear your pump",
        "kind": "video",
        "url": "https://cdn.example.com/wear-guide.mp4"
      },
      {
        "title": "Unsupported resource",
        "kind": "other",
        "url": "https://cdn.example.com/raw.zip"
      }
    ],
    "ibclc": {
      "start": {
        "baseUrl": "/services",
        "consultId": "consult-001",
        "threadId": "thread-ibclc-001",
        "returnTo": "/me",
        "userId": "demo-user-001"
      },
      "storedReturnViewport": {
        "return_to": "/me",
        "consult_id": "consult-001",
        "scroll_top": 420,
        "scroll_height": 1600,
        "saved_at": 1782687600000
      },
      "completionPayload": {
        "type": "momcozy.ibclc_consult_completed",
        "conversation_id": "thread-ibclc-001",
        "consult_id": "consult-001",
        "event_type": "ibclc_consult_completed",
        "completed_at": "2026-06-29T10:00:00+08:00"
      }
    }
  },
  "expectedIntents": [
    {
      "type": "ShowToast",
      "payload": {
        "message": "This resource has expired. Please request the latest version."
      }
    },
    {
      "type": "OpenMediaViewer",
      "path": "/media-viewer",
      "payload": {
        "kind": "video",
        "title": "How to wear your pump",
        "url": "https://cdn.example.com/wear-guide.mp4"
      }
    },
    {
      "type": "ShowToast",
      "payload": {
        "message": "This resource cannot be opened in the app yet."
      }
    },
    {
      "type": "OpenServiceCatalog",
      "path": "/services",
      "payload": {
        "consultId": "consult-001",
        "threadId": "thread-ibclc-001",
        "returnTo": "/me",
        "userId": "demo-user-001"
      }
    },
    {
      "type": "ReturnFromIbclc",
      "path": "/me",
      "payload": {
        "consultId": "consult-001",
        "scrollTop": 420,
        "scrollHeight": 1600,
        "completionEvent": "ibclc_consult_completed"
      },
      "consume": "once"
    }
  ],
  "sideEffects": {},
  "assertions": [
    "retired skill-assets media URLs fail closed before the media viewer",
    "unsupported doc kind does not navigate",
    "IBCLC return_to must be same-origin path",
    "IBCLC booking context is handed to the service catalog without local consultation state"
  ]
}
