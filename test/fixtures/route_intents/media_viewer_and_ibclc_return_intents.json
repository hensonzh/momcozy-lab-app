{
  "id": "route-media-viewer-and-ibclc-return-intents",
  "description": "Media viewer and IBCLC return flow map to typed route intents with safe URL handling.",
  "input": {
    "mediaLinks": [
      {
        "title": "泵奶指南 PDF",
        "kind": "pdf",
        "url": "/skill-assets/guides/pump.pdf"
      },
      {
        "title": "佩戴视频",
        "kind": "video",
        "url": "https://cdn.example.com/wear-guide.mp4"
      },
      {
        "title": "不支持资料",
        "kind": "other",
        "url": "https://cdn.example.com/raw.zip"
      }
    ],
    "ibclc": {
      "start": {
        "baseUrl": "/ibclc-chat.html",
        "consultId": "consult-001",
        "threadId": "thread-ibclc-001",
        "returnTo": "/me",
        "userId": "demo-user-001"
      },
      "storedReturnViewport": {
        "return_to": "/me",
        "consult_id": "consult-001",
        "scroll_top": 420,
        "scroll_height": 1600,
        "saved_at": 1782687600000
      },
      "completionPayload": {
        "type": "momcozy.ibclc_consult_completed",
        "conversation_id": "thread-ibclc-001",
        "consult_id": "consult-001",
        "event_type": "ibclc_consult_completed",
        "completed_at": "2026-06-29T10:00:00+08:00"
      }
    }
  },
  "expectedIntents": [
    {
      "type": "ShowToast",
      "payload": {
        "message": "该资料已失效，请获取最新资料。"
      }
    },
    {
      "type": "OpenMediaViewer",
      "path": "/media-viewer",
      "payload": {
        "kind": "video",
        "title": "佩戴视频",
        "url": "https://cdn.example.com/wear-guide.mp4"
      }
    },
    {
      "type": "ShowToast",
      "payload": {
        "message": "该资料暂不支持应用内打开"
      }
    },
    {
      "type": "OpenIbclcChat",
      "path": "/ibclc-chat.html",
      "payload": {
        "consultId": "consult-001",
        "threadId": "thread-ibclc-001",
        "returnTo": "/me",
        "userId": "demo-user-001"
      }
    },
    {
      "type": "ReturnFromIbclc",
      "path": "/me",
      "payload": {
        "consultId": "consult-001",
        "scrollTop": 420,
        "scrollHeight": 1600,
        "completionEvent": "ibclc_consult_completed"
      },
      "consume": "once"
    }
  ],
  "sideEffects": {
    "ibclcStorage": [
      "momcozy_ibclc_consult_completed updated",
      "momcozy_ibclc_consult_completions append unique consult id",
      "momcozy_ibclc_return_viewport cleared after restore"
    ]
  },
  "assertions": [
    "retired skill-assets media URLs fail closed before the media viewer",
    "unsupported doc kind does not navigate",
    "IBCLC return_to must be same-origin path",
    "IBCLC viewport restore expires after 10 minutes",
    "IBCLC completion dedupes by consult_id before appending history"
  ]
}
