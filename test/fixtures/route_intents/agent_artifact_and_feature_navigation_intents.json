{
  "id": "route-agent-artifact-and-feature-navigation-intents",
  "description": "Agent and feature navigation use canonical Flutter route intents.",
  "input": {
    "events": [
      {
        "source": "AgentHub bubble link",
        "link": {
          "label": "View Plan →",
          "action": "open-schedule"
        }
      },
      {
        "source": "Plan adjust button",
        "navigate": {
          "path": "/",
          "state": {
            "agentPrefill": "我想调整今天的吸乳排期"
          }
        }
      },
      {
        "source": "Inline maternity flow",
        "customEvent": {
          "name": "navigate-to",
          "detail": "/schedule"
        }
      },
      {
        "source": "Work flow trigger",
        "customEvent": {
          "name": "hub-start-work-flow"
        }
      }
    ]
  },
  "expectedIntents": [
    {
      "type": "OpenScheduleFromAgent",
      "path": "/schedule",
      "payload": {
        "source": "agentBubbleLink",
        "action": "open-schedule"
      }
    },
    {
      "type": "OpenAgentHubWithPrefill",
      "path": "/",
      "payload": {
        "agentPrefill": "我想调整今天的吸乳排期",
        "autoSend": true
      }
    },
    {
      "type": "OpenSchedule",
      "path": "/schedule",
      "payload": {
        "source": "inlineFlow"
      }
    },
    {
      "type": "OpenAgentHubAndStartWorkFlow",
      "path": "/",
      "payload": {
        "prompt": "我想制定返工计划"
      }
    }
  ],
  "assertions": [
    "query params are converted to typed flags",
    "agentPrefill is stored as a typed payload instead of untyped router state",
    "custom DOM events are removed from Flutter design and replaced with an app event bus",
    "unknown agent artifact routes fall back to an AgentArtifactRouteIntent with raw value logged in diagnostics"
  ]
}
