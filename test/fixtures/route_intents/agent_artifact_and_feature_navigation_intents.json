{
  "id": "route-agent-artifact-and-feature-navigation-intents",
  "description": "Agent artifacts and feature-to-feature navigation produce typed intents instead of raw routes.",
  "input": {
    "events": [
      {
        "source": "AgentHub bubble link",
        "link": {
          "label": "查看日程→",
          "action": "open-schedule"
        }
      },
      {
        "source": "AgentHub calibration card",
        "route": "/calibration"
      },
      {
        "source": "Schedule adjust button",
        "navigate": {
          "path": "/",
          "state": {
            "agentPrefill": "我想调整今天的吸乳排期"
          }
        }
      },
      {
        "source": "Device start pump without calibration",
        "route": "/calibration"
      },
      {
        "source": "Pump session missing connected device",
        "route": "/device"
      },
      {
        "source": "Calibration auto start",
        "route": "/pump?from=calibration&autoStarted=1"
      },
      {
        "source": "Inline maternity flow",
        "customEvent": {
          "name": "navigate-to",
          "detail": "/schedule"
        }
      },
      {
        "source": "Work flow trigger",
        "customEvent": {
          "name": "hub-start-work-flow"
        }
      }
    ]
  },
  "expectedIntents": [
    {
      "type": "OpenScheduleFromAgent",
      "path": "/schedule",
      "payload": {
        "source": "agentBubbleLink",
        "action": "open-schedule"
      }
    },
    {
      "type": "OpenCalibrationFromAgent",
      "path": "/calibration",
      "payload": {
        "source": "agentArtifact"
      }
    },
    {
      "type": "OpenAgentHubWithPrefill",
      "path": "/",
      "payload": {
        "agentPrefill": "我想调整今天的吸乳排期",
        "autoSend": true
      }
    },
    {
      "type": "OpenCalibrationRequired",
      "path": "/calibration",
      "payload": {
        "source": "deviceStartPump"
      }
    },
    {
      "type": "OpenDeviceRequired",
      "path": "/device",
      "payload": {
        "source": "pumpSession"
      }
    },
    {
      "type": "OpenPumpSession",
      "path": "/pump",
      "payload": {
        "from": "calibration",
        "autoStarted": true
      }
    },
    {
      "type": "OpenSchedule",
      "path": "/schedule",
      "payload": {
        "source": "inlineFlow"
      }
    },
    {
      "type": "OpenAgentHubAndStartWorkFlow",
      "path": "/",
      "payload": {
        "prompt": "我想制定返工计划"
      }
    }
  ],
  "assertions": [
    "query params are converted to typed flags",
    "agentPrefill is stored as a typed payload instead of untyped router state",
    "custom DOM events are removed from Flutter design and replaced with an app event bus",
    "device/calibration/pump gating reasons are preserved for analytics and UI copy",
    "unknown agent artifact route falls back to AgentArtifactRouteIntent with raw value logged in diagnostics"
  ]
}
