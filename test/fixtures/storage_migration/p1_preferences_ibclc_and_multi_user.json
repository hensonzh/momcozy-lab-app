    "sessionStorage": {},
    "capacitorPreferences": {},
    "androidSharedPreferences": {}
  },
  "context": {
    "activeUserId": "demo-user-active",
    "ibclcFeatureRetained": true,
    "internalDevBuild": true
  },
  "expected": {
    "scopedKeyValue": {
      "runtime.userId": "demo-user-active",
      "runtime.momStage": "prenatal",
      "status.careStage": "pregnancy",
      "preferences.volumeUnit": "mL",
      "ibclc.clientUserId": "ibclc-user-001",
      "ibclc.consultCompleted": true
    },
    "localHistory": {
      "ibclc.consultCompletions": [
        {
          "completed": true,
          "completedAt": "2026-06-20T10:00:00.000Z"
        },
        {
          "completed": true,
          "completedAt": "2026-06-29T10:00:00.000Z"
        }
      ],
      "dev.userSnapshots": [
        {
          "userId": "demo-user-old",
          "momStage": "postpartum",
          "valuesMigrated": [
            "agent.conversationId",
            "agent.threadId",
            "calibration"
          ]
        }
      ]
    },
    "routeIntentQueue": [
      {
        "type": "ibclcReturn",
        "target": "/status",
        "payload": {
          "scrollY": 420
        },
        "consume": "once"
      }
    ],
    "deleteLegacyKeys": {
      "localStorage": [
        "momcozy_ibclc_return_to",
        "momcozy_ibclc_return_viewport"
      ]
    },
    "migrationVersion": 1
  },
  "assertions": [
    "status care stage is migrated only when value is pregnancy or postpartum",
    "IBCLC durable completion state migrates only if IBCLC feature is retained",
    "IBCLC return path and viewport become one-shot route intent",
    "dev multi-user snapshots migrate only for internal/dev builds",
    "active user data and other user snapshots remain isolated"
