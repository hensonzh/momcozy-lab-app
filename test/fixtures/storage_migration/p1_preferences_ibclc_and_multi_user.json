  "legacy": {
    "localStorage": {
      "mai_debug_user_id": "demo-user-active",
      "mai_debug_user_stage": "prenatal",
      "mai_debug_user_ids": "[\"demo-user-old\",\"demo-user-active\"]",
      "mai_debug_user_data:demo-user-old": "{\"momStage\":\"postpartum\",\"values\":{\"mai_agent_conversation_id\":\"conv-old\",\"momcozy_conversation_id\":\"thread-old\",\"calibration\":\"{\\\"L\\\":{\\\"stimCozy\\\":3,\\\"deepCozy\\\":6},\\\"R\\\":{\\\"stimCozy\\\":4,\\\"deepCozy\\\":7},\\\"stimCozy\\\":3,\\\"deepCozy\\\":6}\"}}",
      "momcozy_status_care_stage": "pregnancy",
      "volume-unit": "mL",
      "momcozy_user_id": "ibclc-user-001",
      "momcozy_ibclc_consult_completed": "{\"completed\":true,\"completedAt\":\"2026-06-29T10:00:00.000Z\"}",
      "momcozy_ibclc_consult_completions": "[{\"completed\":true,\"completedAt\":\"2026-06-20T10:00:00.000Z\"},{\"completed\":true,\"completedAt\":\"2026-06-29T10:00:00.000Z\"}]",
      "momcozy_ibclc_return_to": "/status",
      "momcozy_ibclc_return_viewport": "{\"path\":\"/status\",\"scrollY\":420,\"createdAt\":1782687600000}"
