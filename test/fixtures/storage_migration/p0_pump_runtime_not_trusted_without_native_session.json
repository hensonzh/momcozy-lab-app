{
  "id": "storage-p0-pump-runtime-not-trusted-without-native-session",
  "description": "Browser session pump runtime keys must not resurrect a pump session unless native service state confirms an active session.",
  "legacy": {
    "localStorage": {
      "pump_session_state": "running"
    },
    "sessionStorage": {
      "pump_session_state": "running",
      "pump_session_letdown_counts": "{\"L\":2,\"R\":1}",
      "pump_session_process_all": "76",
      "pump_completion_notified": "1"
    },
    "capacitorPreferences": {},
    "androidSharedPreferences": {
      "PumpAgentNativeStore": "{\"sessionId\":\"legacy-native-session\",\"uploadInFlight\":true}"
    }
  },
  "context": {
    "nativeActivePumpSession": null,
    "deviceSnapshot": {
      "L": null,
      "R": null
    }
  },
  "expected": {
    "pumpSessionState": {
      "state": "idle",
      "restoredFromLegacyBrowserStorage": false,
      "requiresNativeValidation": true
    },
    "nativeServiceStore": {
      "PumpAgentNativeStore": {
        "preserveForNativeCleanup": true,
        "exposeToFlutterAsActiveSession": false
      }
    },
    "deleteLegacyKeys": {
      "localStorage": [
        "pump_session_state"
      ],
      "sessionStorage": [
        "pump_session_state",
        "pump_session_letdown_counts",
        "pump_session_process_all",
        "pump_completion_notified"
      ]
    },
    "diagnostics": [
      {
        "code": "ignored_legacy_pump_runtime_without_native_active_session",
        "severity": "info"
      }
    ],
    "migrationVersion": 1
  },
  "assertions": [
    "legacy browser pump_session_state does not start Flutter pump session",
    "letdown and process progress are ignored without native active-session validation",
    "native store may be preserved for Android cleanup but is not exposed as active Flutter state",
    "legacy localStorage pump_session_state is removed"
  ]
}
